DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Shared secret: Express sends it in the X-Service-Key header. Must match
# ML_SERVICE_API_KEY in backend/.env.
ML_SERVICE_API_KEY=change-me

# Sports data: https://www.api-football.com (dashboard → API key)
API_FOOTBALL_KEY=
# One API-Sports key covers football, basketball, American football, volleyball and MMA, but each
# sport is a separate subscription. Free plans only serve yesterday-tomorrow and seasons up to
# 2024, which is not enough to rate teams for this season's tips.
# League IDs shown in the fixtures list (API-Football IDs)
# 39 EPL, 140 La Liga, 135 Serie A, 78 Bundesliga, 61 Ligue 1, 2 UCL, 3 UEL, 88 Eredivisie, 94 Primeira, 399 NPFL
SPORTS_LEAGUES=39,140,135,78,61,2,3,88,94,399
