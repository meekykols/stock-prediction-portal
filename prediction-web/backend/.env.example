NODE_ENV=development
PORT=5050

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/prediction_web

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed origins (frontend, admin)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# 'lax' when frontend/API share a domain (or use the Vite proxy); 'none' for cross-site in production
COOKIE_SAMESITE=lax

# Cloudinary (logo/avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — dashboard → Settings → API Keys & Webhooks
# Webhook URL to register there: https://<your-api-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Customer site URL; Paystack redirects to <APP_URL>/app/billing/callback after payment
APP_URL=http://localhost:5173

# Django ML service (Phase 3)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=

# Sports data (Phase 3) - https://www.api-football.com
API_FOOTBALL_KEY=
